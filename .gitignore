.venv/
__pycache__/
*.pyc
*.wav
*.m4a
*.DS_Store
!voices/*.wav

# Afterwords TTS voice override
.afterwords

# Private voices — available locally on the dev machine and loaded by the
# server at runtime, but not shipped in the repo. These are personal/test
# profiles that don't need to be distributed.
voices/muse*
voices/vixen*

# QA artefacts
qa-run.txt
docs/*-audit.json
*-output.log
pytest-output.log
setup-output*.log
session-report-*.html
transcripts/youtube/*.json

# Claude Code runtime locks (created by /loop / scheduled tasks)
.claude/scheduled_tasks.lock

# Skill eval workspace (generated during testing)
skill/*-workspace/

# Voice WAV backups produced by trim-silence-gaps.py
voices/*.wav.bak

# LLVM coverage artefacts from instrumented binaries
*.profraw
