+def _afterwords_bridge():
+    """Return the Afterwords native bridge, or fail before any audio work.
+
+    The bridge owns the mute flag and the shared playback lease. Stock playback bypasses
+    both, so a missing or incomplete bridge must fail loudly here instead of degrading to
+    unguarded audio: this dependency is deliberate and installation is hash-checked.
+    """
+    try:
+        import afterwords_native as bridge
+    except ImportError as exc:
+        raise RuntimeError(
+            "afterwords_native is not importable; reinstall the Afterwords native bridge "
+            "(afterwords/scripts/prepare-hermes-native.py). Refusing to synthesise or play "
+            "audio outside the shared playback lease.") from exc
+    missing = [name for name in ("native_synthesis", "native_playback", "command_environment")
+               if not callable(getattr(bridge, name, None))]
+    if missing:
+        raise RuntimeError(
+            "afterwords_native is missing %s; reinstall the Afterwords native bridge "
+            "(afterwords/scripts/prepare-hermes-native.py)." % ", ".join(missing))
+    return bridge
